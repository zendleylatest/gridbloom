# MongoDB — base URI without relying on path DB name; app uses MONGODB_DB_NAME
MONGODB_URI=mongodb://127.0.0.1:27017

# Dedicated database name (collections: promptgenerations)
MONGODB_DB_NAME=ai_prompt_generator

# Server
PORT=8000
# Comma-separated list of allowed web origins for CORS
CORS_ORIGINS=http://localhost:3000,https://aipromptgenerator.oxmite.com,https://prompt-creator-admin.oxmite.com

# Auth (same routes as ai_image_generator_backend — JWT + optional Google)
JWT_SECRET=change-me-to-a-long-random-string
# Google Sign-In: Web client ID from Google Cloud (used to verify idToken)
GOOGLE_CLIENT_ID=611593247799-d02g8kil80oavsfdef7ek22qjbjjqtgl.apps.googleusercontent.com
# Optional extra audiences (comma separated), e.g. an iOS OAuth client ID
GOOGLE_CLIENT_IDS=

# Gmail for OTP / password reset (optional in dev — OTP is logged if unset)
EMAIL_USER=
EMAIL_PASS=

# OpenAI (chat completion for prompt text)
OPENAI_API_KEY=
# Optional override (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# In-app purchases
# Amazon Appstore Receipt Verification Service developer/shared secret.
AMAZON_RVS_SHARED_SECRET=
# Set to true only when testing Amazon IAP with App Tester.
AMAZON_RVS_SANDBOX=false

# Admin dashboard authentication
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin@gmail.com
ADMIN_JWT_SECRET=change-me-admin-secret

# Push notifications (Firebase Admin service account JSON as one-line string)
# Important: in private_key use escaped newlines (\\n), not raw line breaks.
# Example:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...,"private_key":"-----BEGIN PRIVATE KEY-----\\nABC...\\n-----END PRIVATE KEY-----\\n",...}
FIREBASE_SERVICE_ACCOUNT=
# Same as admin-service style: JSON string or base64-encoded JSON
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional path to service account file (default: ./firebase-service-account.json)
FIREBASE_SERVICE_ACCOUNT_PATH=
# Free usage limits
CARE_FREE_CHAT_LIMIT=5
CARE_REGISTERED_CHAT_LIMIT=10
CARE_GUEST_LOG_LIMIT=3
CARE_REGISTERED_LOG_LIMIT=5
ANDROID_PACKAGE_NAME=com.speckpro.gridbloomgame.android

# Daily reminder pushes: the same push to every registered device, twice a day,
# at the same UTC times for everyone (time zones are ignored on purpose).
# Leave false on a dev machine that points at the live database.
DAILY_REMINDERS_ENABLED=false
DAILY_REMINDER_TIMES_UTC=09:00,18:00
# Optional: service account JSON (or base64) for the Firebase project the app uses,
# when it differs from firebase-service-account.json.
# REMINDER_FIREBASE_SERVICE_ACCOUNT=

# Legacy Luna period reminders (not used by Gridbloom). Period reminder pushes. PUSH_ENABLED turns on the real "period in 2 days" push;
# DEBUG_ENABLED enables POST /api/notifications/debug-period-reminder (test push after ~10 min).
PERIOD_REMINDER_PUSH_ENABLED=false
PERIOD_REMINDER_DEBUG_ENABLED=false
# Optional: service account JSON (or base64) for the Firebase project the app uses,
# when it differs from firebase-service-account.json.
# PERIOD_REMINDER_FIREBASE_SERVICE_ACCOUNT=

# --- One-time purchases (Google Play, App Store, Amazon) ---
# Google Play: service account JSON (one line) with Play Console API access, or
# put the file at backend/google-play-service-account.json
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# App Store Server API key (App Store Connect > Users and Access > Integrations)
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_SANDBOX=false
APPLE_BUNDLE_ID=com.speckpro.gridbloomgame.android
